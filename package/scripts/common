#!/bin/sh
# Shared helpers for the package lifecycle scripts.

PKG_NAME="synology-frp"
VAR_DIR="${SYNOPKG_PKGVAR:-/var/packages/${PKG_NAME}/var}"
DEST_DIR="${SYNOPKG_PKGDEST:-/var/packages/${PKG_NAME}/target}"
PID_FILE="${VAR_DIR}/frpc.pid"
LOG_DIR="${VAR_DIR}/logs"
PORT="${SYNOFRP_PORT:-9844}"
PYTHON_BIN=""

resolve_python() {
    for candidate in /usr/bin/python3 /usr/local/bin/python3 \
        /var/packages/Python3/target/bin/python3 /var/packages/Python3.9/target/bin/python3; do
        if [ -x "$candidate" ]; then
            PYTHON_BIN="$candidate"
            return 0
        fi
    done
    return 1
}

ensure_dirs() {
    mkdir -p "$VAR_DIR" "$LOG_DIR" || return 1
    return 0
}

# The UI service (what DSM starts/stops) and frpc itself are tracked separately:
# the UI can be running while frpc is stopped because of a broken config.
is_running() {
    [ -f "$VAR_DIR/ui.pid" ] || return 1
    pid="$(cat "$VAR_DIR/ui.pid" 2>/dev/null)"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

# Without SSH there is no way to look at the DSM side of the story, so the
# lifecycle scripts publish what they can see to a file inside the web-served
# ui directory (/webman/3rdparty/<pkg>/_diag.txt). It is written on every
# start attempt and contains no configuration content.
publish_diag() {
    target="${DEST_DIR}/ui/_diag.txt"
    [ -d "${DEST_DIR}/ui" ] || return 0
    {
        echo "time: $(date)"
        echo "pid file: $(cat "${VAR_DIR}/ui.pid" 2>/dev/null || echo none)"
        echo "service running: $(is_running && echo yes || echo no)"
        echo
        echo "== python =="
        for candidate in /usr/bin/python3 /usr/local/bin/python3 \
            /var/packages/Python3/target/bin/python3 /var/packages/Python3.9/target/bin/python3; do
            if [ -x "$candidate" ]; then
                echo "  OK  ${candidate}  $("${candidate}" -V 2>&1)"
            else
                echo "  --  ${candidate}"
            fi
        done
        echo
        echo "== listening on ${PORT} =="
        if command -v netstat >/dev/null 2>&1; then
            netstat -tln 2>/dev/null | grep -E "[:.]${PORT}[[:space:]]" || echo "  (nothing)"
        elif command -v ss >/dev/null 2>&1; then
            ss -tln 2>/dev/null | grep -E "[:.]${PORT}[[:space:]]" || echo "  (nothing)"
        else
            echo "  (no netstat/ss)"
        fi
        echo
        echo "== service.log (tail) =="
        tail -30 "${LOG_DIR}/service.log" 2>/dev/null || echo "  (no log)"
        echo
        echo "== nginx: where our location ended up =="
        echo "  -- files mentioning synology-frp --"
        grep -rl "synology-frp" /etc/nginx 2>/dev/null | head -10 || echo "  (none)"
        echo "  -- conf.d listing --"
        ls -1 /etc/nginx/conf.d 2>/dev/null | head -15 || echo "  (no conf.d)"
        echo "  -- listen ports in conf.d --"
        grep -rh "listen" /etc/nginx/conf.d/*.conf 2>/dev/null | sed 's/^ */    /' | sort -u | head -20 || true
    } >"$target" 2>&1 || true
}
